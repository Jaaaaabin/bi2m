# Copy to .env (gitignored) and fill in what you use. The scripts
# (src/local_env.py), the dev server and `npm start` (server/api.mjs) read it;
# a variable already set in the environment wins. docker compose reads its own
# settings (BI2M_PORT, BI2M_DATA, BI2M_UID, BI2M_GID, BI2M_MAX_UPLOAD_MB) from
# the same file.

# Folder of IFC files: the viewer's model library and the corpus scripts.
BI2M_IFC_CORPUS=
# Visual outputs and the library index (scripts/build_vis_index.py, autocamera.py).
BI2M_VIS_DIR=
# Parent folder of several corpora (scripts/validate_neufert.py's reference models).
BI2M_IFC_ROOT=

# Largest model the viewer's server accepts as an upload, in MB (default 500).
# BI2M_MAX_UPLOAD_MB=500

# docker compose only (see README "Host with Docker"):
# BI2M_PORT=3000
# BI2M_DATA=./data
# BI2M_UID=1000
# BI2M_GID=1000
