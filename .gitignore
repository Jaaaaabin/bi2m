*.bak
# Some Windows tooling creates a literal 'nul' file instead of writing to NUL.
nul

# === Maintainer files (local working copies, not part of the repository) ===
# Engineering log and plans; the public documentation is README.md,
# CONTRIBUTING.md and docs/.
/notes/
/docs/superpowers/
# Literature notes and downloaded papers.
/research/
# Neufert source plans and validation pack.
/neufert_logic.md
/neufert_ifc_requirement_logic.md
/neufert_validation_pack.json

# === Models and pipeline output in data/ ===
# Models are large and most are not ours to publish. Uploads get one folder
# per content key (server/api.mjs); the extraction cache is rebuilt on demand.
data/*.ifc
data/*.rvt
data/uploads/
data/extracted/
# The one exception: the example model, which the verify_* scripts and the
# browser tests run on and whose shard is tracked. Keep it byte-identical:
# its content key names that shard (.gitattributes keeps *.ifc out of
# line-ending normalisation).
!data/example_autcon.ifc

# === Viewer build output and local state ===
viewer/dist/
# web-ifc engine files, copied from node_modules on every dev start and build.
viewer/public/wasm/
# Tile sets (scripts/tileIfc.mjs), rebuilt from a model.
viewer/public/tiles/
viewer/public/temp/
viewer/scripts/e2e/out/
viewer/tests/unit/out/
# Recognition results: one shard per model, computed locally for models other
# people do not have. The tracked fixture shards are unaffected; add a new one
# deliberately with `git add -f`. index.json is a local catalogue.
viewer/public/res/intents/*.json
# Declared-grid line files (scripts/grid_lines.py), same reasoning. Kept: the
# index and the example model's hand-written file, which
# scripts/e2e/overlay_lines.py checks.
viewer/public/res/lines/*.json
!viewer/public/res/lines/index.json
!viewer/public/res/lines/34b3f3dac339ade6.json

# === zihan_dev1: Neufert knowledge → rules work (see BIM_INTENT.md) ===
# The Neufert book and everything parsed from it in full (PDF, VLM pages, embeddings, page/figure dataset) are not ours
# to publish; neither are the 370-model corpus, the ifc-bench models, or graphs extracted from them.
/data/neufert/
/data/model_ifc4_0001-0370/
/data/model_ifc4_0001-0370.zip
/data/ifc_bench/**/*.ifc
/runs/graphs/
/runs/intent_pilot_residential/
/archive/0_archi_rag_agent/tier1/
/archive/3_cuatesting/
# The colleague sweep output stays in research (bi2m keeps /research/ local); our review file is merged into rules/_review.json.
/neufert_applicability_*.json
/rules_review_*.json
