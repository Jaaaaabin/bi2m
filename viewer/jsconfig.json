{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "cameraViews.js",
    "views/direction.js",
    "views/pose.js",
    "views/viewSpec.js",
    "views/frame.js",
    "views/applyView.js",
    "views/viewStore.js",
    "views/bcfExport.js",
    "views/framing.js",
    "views/render.js",
    "views/rules.js",
    "views/intentFrame.js",
    "views/cuts.js",
    "views/scene.js",
    "views/labels.js",
    "views/lineSpec.js",
    "views/lines.js",
    "views/intentLines.js",
    "views/outline.js",
    "views/lineSidecar.js",
    "views/referLines.js",
    "views/linePicker.js",
    "views/visibility.js",
    "intentData.js",
    "aggregateParts.js",
    "verdicts.js",
    "settings.js",
    "debug.js",
    "icons.js",
    "viewerRegistry.js",
    "viewerModel.js",
    "fileIdentity.js",
    "inspector/geometryLabels.js",
    "inspector/describeElement.js"
  ]
}
